# Default configuration for CPL
# Balanced configuration with most features enabled

# Compiler Options
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# CONFIG_CC_OPTIMIZE_FOR_SIZE is not set
CONFIG_DEBUG_INFO=y
# CONFIG_ASAN is not set
# CONFIG_UBSAN is not set
# CONFIG_RELEASE is not set

# Library Modules
CONFIG_CPL_LIB=y
CONFIG_CPL_CORE=y
CONFIG_CPL_CONTAINER=y
CONFIG_CPL_MATRIX=y
CONFIG_CPL_MOD=y
CONFIG_CPL_TREE=y

# Test Suite
CONFIG_CPL_TESTS=y
CONFIG_TEST_CONTAINER_ALTERNATING_INSERTION=y
CONFIG_TEST_CONTAINER_DEBUG_OUTPUT=y
CONFIG_TEST_CONTAINER_ENCODING=y
CONFIG_TEST_CONTAINER_IS_CONTAINER_VALIDATION=y
CONFIG_TEST_CONTAINER_MERGE_SORT=y
CONFIG_TEST_CONTAINER_RANGE_MERGE_SORT=y
CONFIG_TEST_CONTAINER_RANGE_REV_SORT=y
CONFIG_TEST_CONTAINER_REV_SORT=y
CONFIG_TEST_DISJOINT_SET=y
CONFIG_TEST_EDGE_COMPARISON=y
CONFIG_TEST_BORUVKA_MST=y
CONFIG_TEST_KRUSKAL_MST=y
CONFIG_TEST_MATRIX_TRACE=y
CONFIG_TEST_Y_COMBINATOR=y

# Benchmark Suite
CONFIG_CPL_BENCHMARKS=y
CONFIG_BENCH_CONTAINER_MERGE_SORT=y
CONFIG_BENCH_CONTAINER_RUN_LENGTH_ENCODING=y

# Tools
CONFIG_CPL_TOOLS=y
CONFIG_TOOL_GRAPH_CASEGEN=y
