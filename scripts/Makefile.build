#
# scripts/Makefile.build
# This file is included by the top-level Makefile to handle recursive
# directory building. It processes Kbuild files in each directory.

src := $(obj)

PHONY := __build
__build:

# Read auto.conf if it exists
-include include/config/auto.conf

# Read the Kbuild include macros
include scripts/Kbuild.include

# The filename Kbuild has precedence over Makefile
kbuild-dir := $(if $(filter /%,$(src)),$(src),$(srctree)/$(src))
kbuild-file := $(if $(wildcard $(kbuild-dir)/Kbuild),$(kbuild-dir)/Kbuild,$(kbuild-dir)/Makefile)
include $(kbuild-file)

# If the current directory has no obj-y, we're building a leaf
# Otherwise we need to descend into subdirectories

# obj-y lists all object files to build from sources in this directory
# subdir-y lists subdirectories to descend into

include scripts/Makefile.lib

# Do not include host programs in kernel builds
ifneq ($(hostprogs-y)$(hostprogs-m),)
include scripts/Makefile.host
endif

# The C file to be compiled and assembled.
quiet_cmd_cc_o_c = CC      $@
      cmd_cc_o_c = $(CC) $(c_flags) -c -o $@ $<

# The C++ file to be compiled and assembled.
quiet_cmd_cxx_o_cpp = CXX     $@
      cmd_cxx_o_cpp = $(CXX) $(cxx_flags) $(CPPFLAGS) -c -o $@ $<

# Archive into library
quiet_cmd_ar = AR      $@
      cmd_ar = rm -f $@; $(AR) rcs $@ $(filter-out FORCE,$^)

# Link into executable
quiet_cmd_link_o_target = LD      $@
      cmd_link_o_target = $(CXX) $(LDFLAGS) -o $@ $(filter-out FORCE,$^) $(LIBS)

# Link test executable
quiet_cmd_link_test = LD      $@
      cmd_link_test = $(CXX) $(ld_flags) -o $@ $(filter-out FORCE,$^) $(srctree)/cpl/built-in.a

# Link benchmark executable
quiet_cmd_link_bench = LD      $@
      cmd_link_bench = $(CXX) $(ld_flags) -o $@ $(filter-out FORCE,$^) $(srctree)/cpl/built-in.a $(srctree)/benchmarks/benchmark/built-in.a -lpthread

# Handle built-in.a for library archiving
# If we have obj-y, create built-in.a
ifneq ($(strip $(obj-y)),)
targets += $(obj)/built-in.a
__build: $(obj)/built-in.a
$(obj)/built-in.a: $(obj-y) FORCE
	$(call if_changed,ar)
endif

# Handle test executables
# Each test directory should have test.o which gets linked into a test executable
ifneq ($(strip $(obj-y)),)
ifeq ($(notdir $(obj-y)),test.o)
# This directory contains a test.o, create test executable
test-target := $(obj)/test
targets += $(test-target)
__build: $(test-target)
$(test-target): $(obj-y) $(srctree)/cpl/built-in.a FORCE
	$(call if_changed,link_test)
endif
endif

# Handle benchmark executables
# Each benchmark directory should have bench.o which gets linked into a benchmark executable
ifneq ($(strip $(obj-y)),)
ifeq ($(notdir $(obj-y)),bench.o)
# This directory contains a bench.o, create benchmark executable
bench-target := $(obj)/bench
targets += $(bench-target)
__build: $(bench-target)
$(bench-target): $(obj-y) $(srctree)/cpl/built-in.a $(srctree)/benchmarks/benchmark/built-in.a FORCE
	$(call if_changed,link_bench)
endif
endif

# Compile C++ source files to object files
$(obj)/%.o: $(src)/%.cpp FORCE
	$(call if_changed,cxx_o_cpp)

$(obj)/%.o: $(src)/%.cc FORCE
	$(call if_changed,cxx_o_cpp)

# Build subdirectories
# $(subdir-y) is a list of directories to descend into
$(subdir-y): FORCE
	$(Q)$(MAKE) $(build)=$(obj)/$@

# Make sure subdirectories are built before built-in.a
ifneq ($(strip $(subdir-y)),)
__build: $(subdir-y)
endif

# Add prerequisites to __build for any defined targets
__build: $(targets)

# Descending
# ---------------------------------------------------------------------------

PHONY += FORCE

FORCE:

# Read all used C++ dependency files
existing-targets := $(wildcard $(sort $(targets)))
cmd_files := $(wildcard $(foreach f,$(existing-targets),$(dir $(f)).$(notdir $(f)).cmd))

ifneq ($(cmd_files),)
      include $(cmd_files)
endif

# Include dependency files (.d files generated by -MD)
-include $(foreach f,$(obj-y),$(dir $(f)).$(notdir $(f:.o=.d)))

.PHONY: $(PHONY)
